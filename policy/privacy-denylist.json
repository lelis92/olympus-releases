{
  "schema_version": 1,
  "path_patterns": [
    "(^|/)\\.git(/|$)",
    "(^|/)PKM(/|$)",
    "(^|/)Team Knowledge/session-logs(/|$)",
    "(^|/)Deliverables(/|$)",
    "(^|/)Team Inbox(/|$)",
    "(^|/)\\.env($|\\.)",
    "(^|/)(id_rsa|id_ed25519|credentials|secrets?)(\\.|$)",
    "\\.(pfx|p12|key|pem)$"
  ],
  "content_patterns": [
    "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "gh[opsu]_[A-Za-z0-9_]{20,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "AKIA[0-9A-Z]{16}",
    "(?i)(api[_-]?key|client[_-]?secret|access[_-]?token)\\s*[:=]\\s*[A-Za-z0-9_./+\\-=]{16,}"
  ]
}
